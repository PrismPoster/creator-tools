{
  "name": "@prismposter/creator-tools",
  "version": "1.0.0",
  "mcpName": "com.prismposter/creator-tools",
  "description": "Zero-dependency TypeScript utilities and MCP server for video and social creators: aspect-ratio maths, tap tempo, subtitle conversion, platform frame sizes with sourced safe areas, encoding calculators, colour-palette extraction, GIF encoding, image metadata, and C2PA / AI-provenance detection.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "aspect-ratio",
    "safe-area",
    "subtitles",
    "srt",
    "vtt",
    "webvtt",
    "ass",
    "timecode",
    "bitrate",
    "tap-tempo",
    "bpm",
    "video",
    "social-media",
    "instagram-reels",
    "youtube-shorts",
    "tiktok",
    "creator-tools",
    "c2pa",
    "content-credentials",
    "provenance",
    "ai-generated",
    "eu-ai-act",
    "exif",
    "xmp",
    "image-metadata",
    "color-palette",
    "median-cut",
    "gif",
    "lzw"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "PrismLabs OÜ",
  "homepage": "https://www.prismposter.com/tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrismPoster/creator-tools.git"
  },
  "bugs": {
    "url": "https://github.com/PrismPoster/creator-tools/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "prismposter-creator-tools": "dist/mcp.js",
    "prismposter-mcp": "dist/mcp.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aspect-ratio": {
      "types": "./dist/aspect-ratio.d.ts",
      "import": "./dist/aspect-ratio.js"
    },
    "./tempo": {
      "types": "./dist/tempo.d.ts",
      "import": "./dist/tempo.js"
    },
    "./subtitles": {
      "types": "./dist/subtitles.d.ts",
      "import": "./dist/subtitles.js"
    },
    "./social-sizes": {
      "types": "./dist/social-sizes.d.ts",
      "import": "./dist/social-sizes.js"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "import": "./dist/encoding.js"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js"
    },
    "./image-metadata": {
      "types": "./dist/image-metadata.d.ts",
      "import": "./dist/image-metadata.js"
    },
    "./gif": {
      "types": "./dist/gif.d.ts",
      "import": "./dist/gif.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "glama.json",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
